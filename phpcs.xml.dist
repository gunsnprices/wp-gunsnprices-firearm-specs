<?xml version="1.0"?>
<ruleset name="GunsNPrices Firearm Specs">
	<description>WordPress Coding Standards and PHP 7.4+ compatibility for the plugin's own code.</description>

	<file>.</file>
	<exclude-pattern>/vendor-prefixed/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/tools/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress.Files.FileName">
		<!-- index.asset.php is the file name WordPress looks for next to a block script. -->
		<exclude-pattern>/blocks/*/index.asset.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_products"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gunsnprices-firearm-specs"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gnpfs"/>
				<element value="GunsNPricesFirearmSpecs"/>
			</property>
		</properties>
	</rule>
</ruleset>
